{
  "name": "donamas",
  "version": "1.0.0",
  "description": "Sistema de gestion de donaciones de alimentos y recursos",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "test": "jest --coverage --coverageReporters=text --coverageReporters=json-summary",
    "test:verbose": "jest --coverage --verbose",
    "lint": "node -e \"require('./src/app.js'); console.log('Lint OK')\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "branches": 70,
        "statements": 80
      }
    }
  }
}
