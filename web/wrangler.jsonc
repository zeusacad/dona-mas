{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "dona-mas",
  "main": "./worker.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/health"]
  }
}
